# 0：安全演示模式；1：Linux 正式执行模式
GAME_DASHBOARD_EXECUTE=0

GAME_DASHBOARD_DATA=/var/lib/game-dashboard
GAME_ROOT=/srv/games
STEAMCMD_PATH=/opt/steamcmd/steamcmd.sh

# 可选：固定 Minecraft 版本；留空安装 Mojang 当前正式版
# MINECRAFT_VERSION=1.21.8

DASHBOARD_USERNAME=admin
# 使用 werkzeug.security.generate_password_hash 生成
DASHBOARD_PASSWORD_HASH=
DASHBOARD_CSRF_TOKEN=
DASHBOARD_SESSION_SECRET=

PORT=5000
